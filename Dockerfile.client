FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/Order.Client/Order.Client.csproj src/Order.Client/
RUN dotnet restore src/Order.Client/Order.Client.csproj
COPY src/Order.Client/ src/Order.Client/
RUN dotnet publish src/Order.Client/Order.Client.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Order.Client.dll"]
